# Cole a URI do Supabase em Project Settings > Database > Connect > URI
# Use a senha do banco (Database password), não a anon/publishable key.
# Prefira a conexão Session pooler (porta 6543) se a direta (5432) falhar.
DATABASE_URL=postgresql://postgres.SEU-REF:SUA-SENHA-DO-BANCO@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Qualquer texto longo e secreto. Não publique no GitHub.
JWT_SECRET=troque-por-um-segredo-longo

# A API e o site local sobem nesta porta. Abra http://127.0.0.1:3001
PORT=3001

# Primeiro administrador criado automaticamente na tabela ciclofit_users
CICLOFIT_ADMIN_EMAIL=admin@ciclo-fit.local
CICLOFIT_ADMIN_PASSWORD=admin123
